//! Pocshot editor window (Slint). The view is deliberately dumb: it shows the
//! captured image, a committed-annotations overlay, a live preview image, the
//! selection rectangle and the toolbar, and forwards events to Rust. All
//! editing logic lives in `lib.rs`/`editor.rs`.

export global Theme {
    in-out property <color> accent: #3a7bd5;
    in-out property <color> chip-bg: #262626;
    in-out property <color> chip-hover: #3a3a3a;
    in-out property <color> chip-border: #3d3d3d;
    in-out property <color> toolbar-bg: #000000d8;
    in-out property <color> hint-text: #ffffffdd;
    in-out property <color> dim: #00000066;
    in-out property <color> sel-border: #ff3366;
    in-out property <color> handle: #ffffff;
    in-out property <color> canvas-bg: #101010;
    in-out property <color> tooltip-bg: #111111e6;
    in-out property <color> swatch0: #ff3b30;
    in-out property <color> swatch1: #ff9500;
    in-out property <color> swatch2: #ffd60a;
    in-out property <color> swatch3: #34c759;
    in-out property <color> swatch4: #0a84ff;
    in-out property <color> swatch5: #ff2d95;
}

component Sep inherits Rectangle {
    width: 1px;
    height: 26px;
    background: Theme.chip-border;
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <color> fill: #262626;
    in property <bool> active: false;
    in property <length> chip-width: 38px;
    in property <string> tooltip: "";
    callback clicked;

    width: root.chip-width;
    height: 32px;
    border-radius: 6px;
    border-color: Theme.chip-border;
    border-width: 1px;
    background: root.active ? Theme.accent : (ta.has-hover ? Theme.chip-hover : root.fill);

    Text {
        text: root.label;
        color: #ffffff;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if (ta.has-hover && root.tooltip != "") : Rectangle {
        y: -30px;
        x: root.width / 2 - 90px;
        width: 180px;
        height: 22px;
        background: Theme.tooltip-bg;
        border-radius: 4px;
        Text {
            x: 8px;
            width: parent.width - 16px;
            text: root.tooltip;
            color: Theme.hint-text;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

/// A labelled settings row with a toggle chip.
component SettingsRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> value: "off";
    callback toggled;

    height: 34px;
    alignment: start;
    spacing: 8px;

    Text {
        text: root.title;
        color: Theme.hint-text;
        font-size: 13px;
        vertical-alignment: center;
        width: 130px;
    }
    Chip {
        label: root.value == "on" ? "On" : "Off";
        active: root.value == "on";
        chip-width: 48px;
        tooltip: "Toggle";
        clicked => { root.toggled(); }
    }
}

component SelHandle inherits Rectangle {
    in property <bool> show: false;
    in property <length> hx;
    in property <length> hy;
    in property <length> win-w: 1px;
    in property <length> win-h: 1px;
    in property <MouseCursor> cursor: default;
    callback pointer(float, float, int);

    visible: root.show;
    x: root.hx - 4px;
    y: root.hy - 4px;
    width: 8px;
    height: 8px;
    background: Theme.handle;
    border-color: #222222;
    border-width: 1px;

    ta := TouchArea {
        mouse-cursor: root.cursor;
        pointer-event(e) => {
            // Coordinates are relative to this handle; add its own origin to get
            // window coordinates.
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pointer((root.hx - 4px + ta.mouse-x) / root.win-w, (root.hy - 4px + ta.mouse-y) / root.win-h, 0);
            }
            if (e.kind == PointerEventKind.move) {
                root.pointer((root.hx - 4px + ta.mouse-x) / root.win-w, (root.hy - 4px + ta.mouse-y) / root.win-h, 1);
            }
            if (e.kind == PointerEventKind.up) {
                root.pointer((root.hx - 4px + ta.mouse-x) / root.win-w, (root.hy - 4px + ta.mouse-y) / root.win-h, 2);
            }
        }
    }
}

export component EditorWindow inherits Window {
    in property <image> shot;
    in property <image> overlay;
    // Where the image sits in the window (normalised 0..1).
    in property <float> shot-nx;
    in property <float> shot-ny;
    in property <float> shot-nw: 1;
    in property <float> shot-nh: 1;
    in property <image> preview;
    // Normalised (0..1) preview rectangle.
    in property <float> preview-nx;
    in property <float> preview-ny;
    in property <float> preview-nw;
    in property <float> preview-nh;
    in property <bool> preview-visible;
    // Normalised selection rectangle.
    in property <float> sel-nx;
    in property <float> sel-ny;
    in property <float> sel-nw;
    in property <float> sel-nh;
    in property <bool> sel-visible;
    in property <bool> sel-handles-visible: false;
    in property <string> hint;
    in property <int> active-tool: 0;
    in property <int> active-color: 0;
    // Fall back to fullscreen when no explicit placement is known.
    in property <bool> fullscreen: false;
    // Settings panel.
    in property <bool> settings-visible: false;
    in property <string> copy-save-value: "off";
    in property <string> snap-value: "on";
    in property <string> guides-value: "on";
    in property <string> auto-ocr-value: "off";
    in property <int> text-size: 24;
    in property <int> stroke-width: 3;
    in property <string> ocr-confidence-value: "0.50";
    // Help overlay.
    in property <bool> help-visible: false;
    in property <string> help-text: "";
    // Toolbar placement (window pixels), computed in Rust to follow the
    // selection like the egui toolbar does.
    in property <length> toolbar-x: 8px;
    in property <length> toolbar-y: 0px;
    in property <length> toolbar-width: 1060px;

    // phase: 0 = down, 1 = move, 2 = up. Coordinates are normalised 0..1.
    callback pointer(float, float, int);
    callback key(string);
    callback tool(int);
    callback pick-color(int);
    callback action(string);

    background: Theme.canvas-bg;
    no-frame: true;
    always-on-top: true;
    full-screen: root.fullscreen;
    title: "Pocshot";

    init => {
        keys.focus();
    }

    Image {
        source: root.shot;
        x: root.shot-nx * root.width;
        y: root.shot-ny * root.height;
        width: root.shot-nw * root.width;
        height: root.shot-nh * root.height;
    }

    Image {
        source: root.overlay;
        x: root.shot-nx * root.width;
        y: root.shot-ny * root.height;
        width: root.shot-nw * root.width;
        height: root.shot-nh * root.height;
    }

    Image {
        visible: root.preview-visible;
        source: root.preview;
        x: root.preview-nx * root.width;
        y: root.preview-ny * root.height;
        width: root.preview-nw * root.width;
        height: root.preview-nh * root.height;
    }

    ta := TouchArea {
        mouse-cursor: crosshair;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pointer(ta.mouse-x / root.width, ta.mouse-y / root.height, 0);
            }
            if (e.kind == PointerEventKind.move) {
                root.pointer(ta.mouse-x / root.width, ta.mouse-y / root.height, 1);
            }
            if (e.kind == PointerEventKind.up) {
                root.pointer(ta.mouse-x / root.width, ta.mouse-y / root.height, 2);
            }
        }
    }

    // Dim everything outside the selection (only once a real selection exists).
    if (root.sel-handles-visible) : Rectangle {
        x: root.shot-nx * root.width;
        y: root.shot-ny * root.height;
        width: root.shot-nw * root.width;
        height: (root.sel-ny - root.shot-ny) * root.height;
        background: Theme.dim;
    }
    if (root.sel-handles-visible) : Rectangle {
        x: root.shot-nx * root.width;
        y: (root.sel-ny + root.sel-nh) * root.height;
        width: root.shot-nw * root.width;
        height: (root.shot-ny + root.shot-nh - root.sel-ny - root.sel-nh) * root.height;
        background: Theme.dim;
    }
    if (root.sel-handles-visible) : Rectangle {
        x: root.shot-nx * root.width;
        y: root.sel-ny * root.height;
        width: (root.sel-nx - root.shot-nx) * root.width;
        height: root.sel-nh * root.height;
        background: Theme.dim;
    }
    if (root.sel-handles-visible) : Rectangle {
        x: (root.sel-nx + root.sel-nw) * root.width;
        y: root.sel-ny * root.height;
        width: (root.shot-nx + root.shot-nw - root.sel-nx - root.sel-nw) * root.width;
        height: root.sel-nh * root.height;
        background: Theme.dim;
    }

    Rectangle {
        visible: root.sel-visible;
        x: root.sel-nx * root.width;
        y: root.sel-ny * root.height;
        width: root.sel-nw * root.width;
        height: root.sel-nh * root.height;
        background: #00000000;
        border-color: Theme.sel-border;
        border-width: 2px;
    }

    // Selection resize handles: 4 corners + 4 edge midpoints.
    SelHandle { show: root.sel-handles-visible; hx: root.sel-nx * root.width; hy: root.sel-ny * root.height; win-w: root.width; win-h: root.height; cursor: nwse-resize; pointer(nx, ny, ph) => { root.pointer(nx, ny, ph); } }
    SelHandle { show: root.sel-handles-visible; hx: (root.sel-nx + root.sel-nw / 2) * root.width; hy: root.sel-ny * root.height; win-w: root.width; win-h: root.height; cursor: ns-resize; pointer(nx, ny, ph) => { root.pointer(nx, ny, ph); } }
    SelHandle { show: root.sel-handles-visible; hx: (root.sel-nx + root.sel-nw) * root.width; hy: root.sel-ny * root.height; win-w: root.width; win-h: root.height; cursor: nesw-resize; pointer(nx, ny, ph) => { root.pointer(nx, ny, ph); } }
    SelHandle { show: root.sel-handles-visible; hx: (root.sel-nx + root.sel-nw) * root.width; hy: (root.sel-ny + root.sel-nh / 2) * root.height; win-w: root.width; win-h: root.height; cursor: ew-resize; pointer(nx, ny, ph) => { root.pointer(nx, ny, ph); } }
    SelHandle { show: root.sel-handles-visible; hx: (root.sel-nx + root.sel-nw) * root.width; hy: (root.sel-ny + root.sel-nh) * root.height; win-w: root.width; win-h: root.height; cursor: nwse-resize; pointer(nx, ny, ph) => { root.pointer(nx, ny, ph); } }
    SelHandle { show: root.sel-handles-visible; hx: (root.sel-nx + root.sel-nw / 2) * root.width; hy: (root.sel-ny + root.sel-nh) * root.height; win-w: root.width; win-h: root.height; cursor: ns-resize; pointer(nx, ny, ph) => { root.pointer(nx, ny, ph); } }
    SelHandle { show: root.sel-handles-visible; hx: root.sel-nx * root.width; hy: (root.sel-ny + root.sel-nh) * root.height; win-w: root.width; win-h: root.height; cursor: nesw-resize; pointer(nx, ny, ph) => { root.pointer(nx, ny, ph); } }
    SelHandle { show: root.sel-handles-visible; hx: root.sel-nx * root.width; hy: (root.sel-ny + root.sel-nh / 2) * root.height; win-w: root.width; win-h: root.height; cursor: ew-resize; pointer(nx, ny, ph) => { root.pointer(nx, ny, ph); } }

    // Toolbar, row 1: actions.
    Rectangle {
        x: root.toolbar-x;
        y: root.toolbar-y;
        width: root.toolbar-width;
        height: 40px;
        border-radius: 6px;
        background: Theme.toolbar-bg;
    }

    HorizontalLayout {
        x: root.toolbar-x + 8px;
        y: root.toolbar-y + 4px;
        height: 32px;
        spacing: 4px;
        alignment: start;

        Chip { label: "↻"; tooltip: "Refresh capture (re-capture and reset)"; clicked => { root.action("refresh"); } }
        Chip { label: "↶"; tooltip: "Undo (Ctrl+Z)"; clicked => { root.action("undo"); } }
        Chip { label: "↷"; tooltip: "Redo (Ctrl+Shift+Z)"; clicked => { root.action("redo"); } }
        Sep { }
        Chip { label: "Copy"; chip-width: 54px; tooltip: "Copy selection (Enter / Ctrl+C)"; clicked => { root.action("copy"); } }
        Chip { label: "Save"; chip-width: 54px; tooltip: "Save selection as PNG (Ctrl+S)"; clicked => { root.action("save"); } }
        Chip { label: "Pin"; chip-width: 46px; tooltip: "Pin selection to the screen"; clicked => { root.action("pin"); } }
        Sep { }
        Chip { label: "OCR"; chip-width: 46px; tooltip: "Detect text in selection (O)"; clicked => { root.action("ocr"); } }
        Chip { label: "✕ ann"; chip-width: 62px; tooltip: "Clear all annotations"; clicked => { root.action("clear-annotations"); } }
        Chip { label: "✕ sel"; chip-width: 62px; tooltip: "Reset the selection to the whole image"; clicked => { root.action("clear-selection"); } }
        Sep { }
        Chip { label: "⚙"; tooltip: "Settings"; active: root.settings-visible; clicked => { root.action("settings"); } }
        Chip { label: "?"; tooltip: "Help (?)"; active: root.help-visible; clicked => { root.action("help"); } }
        Chip { label: "Quit"; chip-width: 54px; tooltip: "Close (Esc)"; clicked => { root.action("quit"); } }
    }

    // Toolbar, row 2: tools + colours + width.
    Rectangle {
        x: root.toolbar-x;
        y: root.toolbar-y + 44px;
        width: root.toolbar-width;
        height: 44px;
        border-radius: 6px;
        background: Theme.toolbar-bg;
    }

    HorizontalLayout {
        x: root.toolbar-x + 8px;
        y: root.toolbar-y + 50px;
        height: 32px;
        spacing: 4px;
        alignment: start;

        Chip { label: "V"; tooltip: "Select (V) - drag to select, drag inside to move"; active: root.active-tool == 0; clicked => { root.tool(0); } }
        Chip { label: "▭"; tooltip: "Rectangle (R)"; active: root.active-tool == 1; clicked => { root.tool(1); } }
        Chip { label: "▣"; tooltip: "Filled rectangle (Shift+R)"; active: root.active-tool == 2; clicked => { root.tool(2); } }
        Chip { label: "─"; tooltip: "Line (L)"; active: root.active-tool == 3; clicked => { root.tool(3); } }
        Chip { label: "→"; tooltip: "Arrow (A)"; active: root.active-tool == 4; clicked => { root.tool(4); } }
        Chip { label: "○"; tooltip: "Circle (C)"; active: root.active-tool == 5; clicked => { root.tool(5); } }
        Chip { label: "●"; tooltip: "Filled circle (Shift+C)"; active: root.active-tool == 6; clicked => { root.tool(6); } }
        Chip { label: "✎"; tooltip: "Pen (P)"; active: root.active-tool == 7; clicked => { root.tool(7); } }
        Chip { label: "▬"; tooltip: "Highlighter (H)"; active: root.active-tool == 8; clicked => { root.tool(8); } }
        Chip { label: "▨"; tooltip: "Redact (D) - fills text regions when OCR ran"; active: root.active-tool == 9; clicked => { root.tool(9); } }
        Chip { label: "①"; tooltip: "Counter (N) - click or drag a callout"; active: root.active-tool == 10; clicked => { root.tool(10); } }
        Chip { label: "T"; tooltip: "Text (T) - click, type, Enter"; active: root.active-tool == 11; clicked => { root.tool(11); } }
        Chip { label: "◍"; tooltip: "Blur region (B)"; active: root.active-tool == 12; clicked => { root.tool(12); } }
        Chip { label: "▦"; tooltip: "Pixelate region (M)"; active: root.active-tool == 13; clicked => { root.tool(13); } }
        Chip { label: "⌫"; tooltip: "Eraser (E) - click an annotation"; active: root.active-tool == 14; clicked => { root.tool(14); } }
        Chip { label: "G"; tooltip: "Text border (G) - boxes text regions when OCR ran"; active: root.active-tool == 15; clicked => { root.tool(15); } }
        Sep { }
        Chip { label: ""; chip-width: 26px; fill: Theme.swatch0; active: root.active-color == 0; tooltip: "Colour 1"; clicked => { root.pick-color(0); } }
        Chip { label: ""; chip-width: 26px; fill: Theme.swatch1; active: root.active-color == 1; tooltip: "Colour 2"; clicked => { root.pick-color(1); } }
        Chip { label: ""; chip-width: 26px; fill: Theme.swatch2; active: root.active-color == 2; tooltip: "Colour 3"; clicked => { root.pick-color(2); } }
        Chip { label: ""; chip-width: 26px; fill: Theme.swatch3; active: root.active-color == 3; tooltip: "Colour 4"; clicked => { root.pick-color(3); } }
        Chip { label: ""; chip-width: 26px; fill: Theme.swatch4; active: root.active-color == 4; tooltip: "Colour 5"; clicked => { root.pick-color(4); } }
        Chip { label: ""; chip-width: 26px; fill: Theme.swatch5; active: root.active-color == 5; tooltip: "Colour 6"; clicked => { root.pick-color(5); } }
        Sep { }
        Chip { label: "−"; chip-width: 30px; tooltip: "Thinner stroke ( [ )"; clicked => { root.action("width-"); } }
        Text {
            width: 34px;
            text: root.stroke-width;
            color: Theme.hint-text;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        Chip { label: "+"; chip-width: 30px; tooltip: "Thicker stroke ( ] )"; clicked => { root.action("width+"); } }
    }

    // Settings panel.
    if (root.settings-visible) : Rectangle {
        x: root.width - 268px;
        y: root.height - 316px;
        width: 256px;
        height: 236px;
        background: #161616f2;
        border-radius: 8px;
        border-color: Theme.chip-border;
        border-width: 1px;

        Text {
            x: 12px;
            y: 8px;
            text: "Settings";
            color: #ffffff;
            font-size: 15px;
        }

        VerticalLayout {
            x: 12px;
            y: 40px;
            width: 232px;
            spacing: 4px;

            SettingsRow {
                title: "Copy on save";
                value: root.copy-save-value;
                toggled => { root.action("copy-save"); }
            }
            SettingsRow {
                title: "Snapping";
                value: root.snap-value;
                toggled => { root.action("snap"); }
            }
            SettingsRow {
                title: "Show guides";
                value: root.guides-value;
                toggled => { root.action("guides"); }
            }
            SettingsRow {
                title: "Auto OCR";
                value: root.auto-ocr-value;
                toggled => { root.action("auto-ocr"); }
            }
            HorizontalLayout {
                height: 34px;
                spacing: 8px;
                alignment: start;
                Text {
                    text: "OCR confidence";
                    color: Theme.hint-text;
                    font-size: 13px;
                    vertical-alignment: center;
                    width: 130px;
                }
                Chip { label: "−"; chip-width: 30px; clicked => { root.action("ocr-confidence-"); } }
                Text {
                    text: root.ocr-confidence-value;
                    color: #ffffff;
                    font-size: 13px;
                    vertical-alignment: center;
                    width: 44px;
                    horizontal-alignment: center;
                }
                Chip { label: "+"; chip-width: 30px; clicked => { root.action("ocr-confidence+"); } }
            }
            HorizontalLayout {
                height: 34px;
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Theme";
                    color: Theme.hint-text;
                    font-size: 13px;
                    vertical-alignment: center;
                    width: 130px;
                }
                Chip { label: "Reload"; chip-width: 64px; tooltip: "Re-read config.json"; clicked => { root.action("reload-theme"); } }
                Chip { label: "? Help"; chip-width: 64px; clicked => { root.action("help"); } }
            }
            HorizontalLayout {
                height: 34px;
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Text size";
                    color: Theme.hint-text;
                    font-size: 13px;
                    vertical-alignment: center;
                    width: 130px;
                }
                Chip { label: "−"; chip-width: 30px; clicked => { root.action("text-size-"); } }
                Text {
                    text: root.text-size;
                    color: #ffffff;
                    font-size: 13px;
                    vertical-alignment: center;
                    width: 34px;
                    horizontal-alignment: center;
                }
                Chip { label: "+"; chip-width: 30px; clicked => { root.action("text-size+"); } }
            }
        }
    }

    // Help overlay.
    if (root.help-visible) : Rectangle {
        x: root.width / 2 - 320px;
        y: root.height / 2 - 90px;
        width: 640px;
        height: 180px;
        background: #161616f2;
        border-radius: 8px;
        border-color: Theme.chip-border;
        border-width: 1px;

        Text {
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            height: parent.height - 24px;
            text: root.help-text;
            color: #ffffff;
            font-size: 14px;
            wrap: word-wrap;
        }
    }

    // Hint line.
    Rectangle {
        x: 0;
        y: root.height - 28px;
        width: 100%;
        height: 28px;
        background: #000000a0;
    }

    Text {
        x: 12px;
        y: root.height - 28px;
        width: root.width - 24px;
        height: 28px;
        vertical-alignment: center;
        color: Theme.hint-text;
        font-size: 13px;
        text: root.hint;
    }

    keys := FocusScope {
        key-pressed(e) => {
            root.key(e.text);
            accept
        }
    }
}

/// A pinned screenshot snippet: borderless, always-on-top, drag to move,
/// right-click or Esc to close.
export component PinWindow inherits Window {
    in property <image> shot;
    callback dismiss;

    background: #000000;
    no-frame: true;
    always-on-top: true;
    title: "Pocshot pin";

    // Right-click closes; declared below the move area so left-drags reach it.
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.dismiss();
            }
        }
    }

    WindowMoveArea { }

    Image {
        source: root.shot;
        width: 100%;
        height: 100%;
    }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == "\u{1b}" || e.text == "q") {
                root.dismiss();
            }
            accept
        }
    }
}
