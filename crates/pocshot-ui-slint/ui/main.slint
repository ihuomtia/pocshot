//! Pocshot editor window (Slint). The view is deliberately dumb: it shows the
//! captured image, a committed-annotations overlay, a live preview image, the
//! selection rectangle and a toolbar, and forwards events to Rust. All editing
//! logic lives in `lib.rs`/`editor.rs`.

component Chip inherits Rectangle {
    in property <string> label;
    in property <color> fill: #2a2a2a;
    in property <bool> active: false;
    in property <length> chip-width: 34px;
    callback clicked;

    width: root.chip-width;
    height: 30px;
    border-radius: 4px;
    background: root.active ? #3a7bd5 : root.fill;
    border-color: #555555;
    border-width: 1px;

    Text {
        text: root.label;
        color: #ffffff;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component EditorWindow inherits Window {
    in property <image> shot;
    in property <image> overlay;
    // Where the image sits in the window (normalised 0..1).
    in property <float> shot-nx;
    in property <float> shot-ny;
    in property <float> shot-nw: 1;
    in property <float> shot-nh: 1;
    in property <image> preview;
    // Normalised (0..1) preview rectangle.
    in property <float> preview-nx;
    in property <float> preview-ny;
    in property <float> preview-nw;
    in property <float> preview-nh;
    in property <bool> preview-visible;
    // Normalised selection rectangle.
    in property <float> sel-nx;
    in property <float> sel-ny;
    in property <float> sel-nw;
    in property <float> sel-nh;
    in property <bool> sel-visible;
    in property <string> hint;
    in property <int> active-tool: 0;
    in property <int> active-color: 0;
    /// Fall back to fullscreen when no explicit placement is known.
    in property <bool> fullscreen: false;

    // phase: 0 = down, 1 = move, 2 = up. Coordinates are normalised 0..1.
    callback pointer(float, float, int);
    callback key(string);
    callback tool(int);
    callback pick-color(int);
    callback action(string);

    background: #101010;
    no-frame: true;
    always-on-top: true;
    full-screen: root.fullscreen;
    title: "Pocshot";

    init => {
        keys.focus();
    }

    Image {
        source: root.shot;
        x: root.shot-nx * root.width;
        y: root.shot-ny * root.height;
        width: root.shot-nw * root.width;
        height: root.shot-nh * root.height;
    }

    Image {
        source: root.overlay;
        x: root.shot-nx * root.width;
        y: root.shot-ny * root.height;
        width: root.shot-nw * root.width;
        height: root.shot-nh * root.height;
    }

    Image {
        visible: root.preview-visible;
        source: root.preview;
        x: root.preview-nx * root.width;
        y: root.preview-ny * root.height;
        width: root.preview-nw * root.width;
        height: root.preview-nh * root.height;
    }

    Rectangle {
        visible: root.sel-visible;
        x: root.sel-nx * root.width;
        y: root.sel-ny * root.height;
        width: root.sel-nw * root.width;
        height: root.sel-nh * root.height;
        background: #00000000;
        border-color: #ff3366;
        border-width: 2px;
    }

    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pointer(ta.mouse-x / root.width, ta.mouse-y / root.height, 0);
            }
            if (e.kind == PointerEventKind.move) {
                root.pointer(ta.mouse-x / root.width, ta.mouse-y / root.height, 1);
            }
            if (e.kind == PointerEventKind.up) {
                root.pointer(ta.mouse-x / root.width, ta.mouse-y / root.height, 2);
            }
        }
    }

    // Toolbar.
    Rectangle {
        x: 0;
        y: root.height - 76px;
        width: 100%;
        height: 46px;
        background: #000000c8;
    }

    HorizontalLayout {
        x: 6px;
        y: root.height - 76px;
        height: 46px;
        spacing: 3px;
        alignment: start;

        Chip { label: "V"; active: root.active-tool == 0; clicked => { root.tool(0); } }
        Chip { label: "R"; active: root.active-tool == 1; clicked => { root.tool(1); } }
        Chip { label: "▣"; active: root.active-tool == 2; clicked => { root.tool(2); } }
        Chip { label: "L"; active: root.active-tool == 3; clicked => { root.tool(3); } }
        Chip { label: "A"; active: root.active-tool == 4; clicked => { root.tool(4); } }
        Chip { label: "C"; active: root.active-tool == 5; clicked => { root.tool(5); } }
        Chip { label: "●"; active: root.active-tool == 6; clicked => { root.tool(6); } }
        Chip { label: "P"; active: root.active-tool == 7; clicked => { root.tool(7); } }
        Chip { label: "H"; active: root.active-tool == 8; clicked => { root.tool(8); } }
        Chip { label: "D"; active: root.active-tool == 9; clicked => { root.tool(9); } }
        Chip { label: "N"; active: root.active-tool == 10; clicked => { root.tool(10); } }
        Chip { label: "T"; active: root.active-tool == 11; clicked => { root.tool(11); } }
        Chip { label: "B"; active: root.active-tool == 12; clicked => { root.tool(12); } }
        Chip { label: "M"; active: root.active-tool == 13; clicked => { root.tool(13); } }
        Chip { label: "E"; active: root.active-tool == 14; clicked => { root.tool(14); } }

        Chip { label: "1"; chip-width: 24px; fill: #ff3b30; active: root.active-color == 0; clicked => { root.pick-color(0); } }
        Chip { label: ""; chip-width: 24px; fill: #ff9500; active: root.active-color == 1; clicked => { root.pick-color(1); } }
        Chip { label: ""; chip-width: 24px; fill: #ffd60a; active: root.active-color == 2; clicked => { root.pick-color(2); } }
        Chip { label: ""; chip-width: 24px; fill: #34c759; active: root.active-color == 3; clicked => { root.pick-color(3); } }
        Chip { label: ""; chip-width: 24px; fill: #0a84ff; active: root.active-color == 4; clicked => { root.pick-color(4); } }
        Chip { label: ""; chip-width: 24px; fill: #ff2d95; active: root.active-color == 5; clicked => { root.pick-color(5); } }

        Chip { label: "‑"; clicked => { root.action("width-"); } }
        Chip { label: "+"; clicked => { root.action("width+"); } }
        Chip { label: "↶"; clicked => { root.action("undo"); } }
        Chip { label: "OCR"; chip-width: 44px; clicked => { root.action("ocr"); } }
        Chip { label: "Pin"; chip-width: 44px; clicked => { root.action("pin"); } }
        Chip { label: "Copy"; chip-width: 52px; clicked => { root.action("copy"); } }
        Chip { label: "Save"; chip-width: 52px; clicked => { root.action("save"); } }
        Chip { label: "Quit"; chip-width: 52px; clicked => { root.action("quit"); } }
    }

    // Hint line.
    Rectangle {
        x: 0;
        y: root.height - 30px;
        width: 100%;
        height: 30px;
        background: #000000a0;
    }

    Text {
        x: 12px;
        y: root.height - 30px;
        width: root.width - 24px;
        height: 30px;
        vertical-alignment: center;
        color: #ffffffdd;
        font-size: 13px;
        text: root.hint;
    }

    keys := FocusScope {
        key-pressed(e) => {
            root.key(e.text);
            accept
        }
    }
}

/// A pinned screenshot snippet: borderless, always-on-top, drag to move,
/// right-click or Esc to close.
export component PinWindow inherits Window {
    in property <image> shot;
    callback dismiss;

    background: #000000;
    no-frame: true;
    always-on-top: true;
    title: "Pocshot pin";

    // Right-click closes; declared below the move area so left-drags reach it.
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.dismiss();
            }
        }
    }

    WindowMoveArea { }

    Image {
        source: root.shot;
        width: 100%;
        height: 100%;
    }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == "\u{1b}" || e.text == "q") {
                root.dismiss();
            }
            accept
        }
    }
}
